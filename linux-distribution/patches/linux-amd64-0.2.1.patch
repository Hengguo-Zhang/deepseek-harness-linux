new file mode 100644
index 0000000..488a8ac
--- /dev/null
+++ b/apps/desktop/tests/linux-update.spec.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it, vi } from 'vitest'
+import { installLinuxDeb } from '../src/linux-update.ts'
+
+describe('Linux privilege boundary', () => {
+  it('awaits pkexec with an absolute dpkg executable, literal filename, and scrubbed session environment', async () => {
+    const completed = Promise.withResolvers<void>()
+    const execute = vi.fn(() => completed.promise)
+    const pending = installLinuxDeb('/cache/package $(touch unwanted).deb', { uid: () => 1000, execute }, {
+      DISPLAY: ':0', DBUS_SESSION_BUS_ADDRESS: 'session', DEEPSEEK_API_KEY: 'secret',
+      GITHUB_TOKEN: 'secret', PATH: '/untrusted', NODE_OPTIONS: '--inspect',
+    })
+    expect(execute).toHaveBeenCalledExactlyOnceWith('/usr/bin/pkexec', ['/usr/bin/dpkg', '--install', '/cache/package $(touch unwanted).deb'], {
+      PATH: '/usr/sbin:/usr/bin:/sbin:/bin', DISPLAY: ':0', DBUS_SESSION_BUS_ADDRESS: 'session',
+    })
+    let settled = false
+    void pending.then(() => { settled = true })
+    await Promise.resolve()
+    expect(settled).toBe(false)
+    completed.resolve()
+    await pending
+  })
+
+  it.each(['authentication cancelled', 'package installation failed'])('propagates %s without treating it as installation success', async (message) => {
+    const execute = vi.fn(async () => { throw new Error(message) })
+    await expect(installLinuxDeb('/cache/package.deb', { uid: () => 1000, execute })).rejects.toThrow(message)
+  })
+
+  it('refuses root execution and filenames outside the verified DEB path', async () => {
+    const execute = vi.fn(async () => {})
+    await expect(installLinuxDeb('/cache/package.deb', { uid: () => 0, execute })).rejects.toThrow(/without sudo/u)
+    await expect(installLinuxDeb('relative.deb', { uid: () => 1000, execute })).rejects.toThrow(/absolute/u)
+    await expect(installLinuxDeb('/cache/package.AppImage', { uid: () => 1000, execute })).rejects.toThrow(/absolute/u)
+    expect(execute).not.toHaveBeenCalled()
+  })
+})
