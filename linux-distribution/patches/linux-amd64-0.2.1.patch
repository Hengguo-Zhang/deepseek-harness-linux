+++ b/apps/desktop/scripts/tests/linux-build.test.mjs
@@ -0,0 +1,49 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { join } from 'node:path'
+import { desktopTargetBuildPaths, desktopTargetPlatform, resolveDesktopBuildTarget } from '../desktop-build-paths.mjs'
+
+test('Linux preparation uses isolated linux-x64 paths and preserves existing target mappings', () => {
+  assert.equal(resolveDesktopBuildTarget({}, 'linux', 'x64'), 'linux-x64')
+  assert.deepEqual(desktopTargetPlatform('linux-x64'), { platform: 'linux', arch: 'x64' })
+  assert.ok(desktopTargetBuildPaths('linux-x64').runtime.endsWith(join('linux-x64', 'runtime')))
+  assert.deepEqual(desktopTargetPlatform('mac-arm64'), { platform: 'darwin', arch: 'arm64' })
+  assert.deepEqual(desktopTargetPlatform('win-x64'), { platform: 'win32', arch: 'x64' })
+  assert.throws(() => resolveDesktopBuildTarget({}, 'linux', 'arm64'), /unsupported/)
+})
+
+test('Linux packaging selects DEB and a stable GitHub Release feed for upstream RC versions', async () => {
+  const { createLinuxElectronBuilderConfig } = await import('../linux-electron-builder.mjs')
+  const config = createLinuxElectronBuilderConfig({ DSH_LINUX_OTA_REPOSITORY: 'example/linux-harness' })
+  assert.deepEqual(config.linux.target, [{ target: 'deb', arch: ['x64'] }])
+  assert.equal(config.linux.executableName, 'deepseek-harness')
+  assert.equal(config.linux.syncDesktopName, true)
+  assert.equal(config.extraMetadata.desktopName, 'deepseek-harness.desktop')
+  assert.deepEqual(config.publish, [{ provider: 'generic', url: 'https://github.com/example/linux-harness/releases/latest/download/', channel: 'latest' }])
+  assert.equal(config.detectUpdateChannel, false)
+  assert.equal(config.generateUpdatesFilesForAllChannels, true)
+  assert.equal(config.extraMetadata.dshLinuxOtaRepository, 'example/linux-harness')
+  assert.equal(config.extraMetadata.dshDesktopAppId, config.appId)
+  assert.ok(config.deb.depends.includes('polkitd'))
+  assert.ok(config.deb.depends.includes('pkexec'))
+  for (const repository of [undefined, '', '../repo', 'https://github.com/user/repo', 'user/repo/other', 'user/repo?token=secret']) {
+    assert.throws(() => createLinuxElectronBuilderConfig({ DSH_LINUX_OTA_REPOSITORY: repository }), /DSH_LINUX_OTA_REPOSITORY/)
+  }
+})
+
+test('archive commit fallback accepts matching source identity and rejects stale records', async () => {
+  const { mkdtempSync, rmSync, writeFileSync } = await import('node:fs')
+  const { tmpdir } = await import('node:os')
+  const { linuxArchiveCommit } = await import('../linux-build-source.mjs')
+  const root = mkdtempSync(join(tmpdir(), 'linux-source-record-'))
+  try {
+    writeFileSync(join(root, 'package.json'), JSON.stringify({ version: '0.2.1-rc.2' }))
+    assert.throws(() => linuxArchiveCommit(root), /LINUX-SOURCE.json/)
+    for (const record of [{ version: '0.2.0', sha: 'a'.repeat(40) }, { version: '0.2.1-rc.2', sha: 'bad' }, null]) {
+      writeFileSync(join(root, 'LINUX-SOURCE.json'), JSON.stringify(record))
+      assert.throws(() => linuxArchiveCommit(root), /matching package version/)
+    }
+    writeFileSync(join(root, 'LINUX-SOURCE.json'), JSON.stringify({ version: '0.2.1-rc.2', sha: 'a'.repeat(40) }))
+    assert.equal(linuxArchiveCommit(root), 'a'.repeat(40))
+  } finally { rmSync(root, { recursive: true, force: true }) }
+})
diff --git a/apps/desktop/src/linux-update.ts b/apps/desktop/src/linux-update.ts
new file mode 100644
index 0000000..2f4b59f
--- /dev/null
+++ b/apps/desktop/src/linux-update.ts
@@ -0,0 +1,44 @@
+/** Awaited, user-authorized DEB installation without launching Electron as root. */
+import { execFile } from 'node:child_process'
+import { isAbsolute } from 'node:path'
+
+/** Injectable process boundary; successful completion means dpkg exited with status zero. */
+export interface LinuxDebInstallOperations {
+  uid: () => number | undefined
+  execute: (file: string, args: readonly string[], environment: NodeJS.ProcessEnv) => Promise<void>
+}
+
+const operations: LinuxDebInstallOperations = {
+  uid: () => process.getuid?.(),
+  execute: (file, args, env) => new Promise((resolve, reject) => {
+    execFile(file, [...args], { env, encoding: 'utf8', maxBuffer: 1024 * 1024 }, (error, _stdout, stderr) => {
+      if (error === null) { resolve(); return }
+      const code = 'code' in error ? error.code : undefined
+      if (code === 126) reject(new Error('Linux update authorization was cancelled. The application remains open.'))
+      else if (code === 'ENOENT') reject(new Error('Linux update requires /usr/bin/pkexec (package pkexec) and a graphical authentication agent.'))
+      else reject(new Error(`Linux package installation failed (${String(code ?? 'signal')}). ${stderr.trim().slice(-4096)}`))
+    })
+  }),
+}
+
+/**
+ * Install only the main-process-owned package already verified by electron-updater.
+ * @param packagePath Absolute verified download filename; never supplied by a renderer.
+ * @param processOperations Process adapter used by the installed application or isolated tests.
+ * @param environment Session variables needed by the system authentication agent.
+ * @returns Resolves only after successful installation; cancellation and failure retain the application.
+ */
+export async function installLinuxDeb(
+  packagePath: string,
+  processOperations: LinuxDebInstallOperations = operations,
+  environment: NodeJS.ProcessEnv = process.env,
+): Promise<void> {
+  if (!isAbsolute(packagePath) || !packagePath.endsWith('.deb')) throw new Error('Linux update requires a verified absolute .deb filename')
+  if (processOperations.uid() === 0) throw new Error('Linux OTA must run as the desktop user. Start the application without sudo.')
+  // Package installation needs no harness credentials or user-controlled executable search path.
+  const env: NodeJS.ProcessEnv = { PATH: '/usr/sbin:/usr/bin:/sbin:/bin' }
+  for (const name of ['DISPLAY', 'WAYLAND_DISPLAY', 'XAUTHORITY', 'XDG_RUNTIME_DIR', 'DBUS_SESSION_BUS_ADDRESS', 'LANG', 'LC_ALL']) {
+    if (environment[name] !== undefined) env[name] = environment[name]
+  }
+  await processOperations.execute('/usr/bin/pkexec', ['/usr/bin/dpkg', '--install', packagePath], env)
+}
