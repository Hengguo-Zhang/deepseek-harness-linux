+#!/usr/bin/env bash
+# Build a public GitHub Release OTA package on Ubuntu 24.04 amd64.
+set -euo pipefail
+cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
+
+if ! command -v node >/dev/null 2>&1; then
+  echo 'Node.js is missing. Install Node ^22.19.0 or >=24 and enable Corepack, then retry.' >&2
+  exit 1
+fi
+node --input-type=module <<'JS'
+const [major, minor] = process.versions.node.split('.').map(Number)
+if (!((major === 22 && minor >= 19) || major >= 24)) throw new Error('Node ^22.19.0 or >=24 is required')
+if (process.platform !== 'linux' || process.arch !== 'x64') throw new Error('Run this build on Linux amd64 (Ubuntu 24.04)')
+const { linuxOtaRepository } = await import('./apps/desktop/scripts/linux-electron-builder.mjs')
+linuxOtaRepository()
+JS
+if command -v pnpm >/dev/null 2>&1; then
+  package_manager=(pnpm)
+elif command -v corepack >/dev/null 2>&1; then
+  package_manager=(corepack pnpm)
+else
+  echo 'Corepack/pnpm is missing. Enable Corepack or install the pnpm version in package.json.' >&2
+  exit 1
+fi
+expected_pnpm=$(node -p 'JSON.parse(require("node:fs").readFileSync("package.json", "utf8")).packageManager.replace("pnpm@", "")')
+actual_pnpm=$("${package_manager[@]}" --version)
+if [[ "$actual_pnpm" != "$expected_pnpm" ]]; then
+  echo "pnpm $expected_pnpm is required; found $actual_pnpm." >&2
+  exit 1
+fi
+# Downloaded source archives record their official commit without requiring Git metadata.
+if [[ -z "${DSH_CLIENT_COMMIT_HASH:-}" ]]; then
+  source_git_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
+  if [[ "$source_git_root" != "$(pwd -P)" ]]; then
+    DSH_CLIENT_COMMIT_HASH=$(node --input-type=module <<'JS'
+import { linuxArchiveCommit } from './apps/desktop/scripts/linux-build-source.mjs'
+process.stdout.write(linuxArchiveCommit(process.cwd()))
+JS
+)
+    export DSH_CLIENT_COMMIT_HASH
+  fi
+fi
+export DSH_DESKTOP_TARGET_PLATFORM=linux
+export DSH_DESKTOP_TARGET_ARCH=x64
+unset DSH_DESKTOP_UNSIGNED DSH_DESKTOP_BUILD_VERSION
+
+"${package_manager[@]}" install --frozen-lockfile
+"${package_manager[@]}" run build:official
+build_root="$PWD/apps/desktop/.desktop-build/targets/linux-x64"
+"${package_manager[@]}" run release:pack --family dsh --out "$build_root/packed/dsh"
+"${package_manager[@]}" --dir apps/desktop-host pack --pack-destination "$build_root/packed/dsh"
+"${package_manager[@]}" run release:pack --family vendor --out "$build_root/packed/vendor"
+rm -rf -- "$build_root/packed/landlock"
+mkdir -p -- "$build_root/packed/landlock"
+"${package_manager[@]}" --dir native/system run build:ts
+"${package_manager[@]}" --dir native/system/packages/entry pack --pack-destination "$build_root/packed/landlock"
+"${package_manager[@]}" --dir apps/desktop run prepare:runtime
+"${package_manager[@]}" --dir apps/desktop run prepare:packages
+"${package_manager[@]}" --dir apps/desktop run prepare:dsh
+# The output directory belongs only to this Linux build; stale packages must never reach a release.
+rm -rf -- "$PWD/dist/linux-ota"
+"${package_manager[@]}" --dir apps/desktop exec electron-builder --linux deb --x64 --publish never --config scripts/linux-electron-builder.mjs
+cp -- dist/linux-ota/linux-unpacked/resources/app-update.yml dist/linux-ota/app-update.yml
+node --input-type=module <<'JS'
+import { createHash } from 'node:crypto'
+import { readFileSync, readdirSync, statSync } from 'node:fs'
+import { join } from 'node:path'
+import yaml from 'js-yaml'
+const output = 'dist/linux-ota'
+const packages = readdirSync(output).filter(file => file.endsWith('.deb'))
+if (packages.length !== 1) throw new Error(`Expected one DEB; found ${packages.length}`)
+const file = packages[0]
+const bytes = readFileSync(join(output, file))
+const sha512 = createHash('sha512').update(bytes).digest('base64')
+const metadata = yaml.load(readFileSync(join(output, 'latest-linux.yml'), 'utf8'))
+const version = JSON.parse(readFileSync('apps/desktop/package.json', 'utf8')).version
+if (metadata.version !== version || metadata.files?.length !== 1 || metadata.files[0].url !== file
+  || metadata.files[0].sha512 !== sha512 || metadata.files[0].size !== statSync(join(output, file)).size
+  || (metadata.sha512 !== undefined && metadata.sha512 !== sha512)) throw new Error('Generated OTA metadata does not describe the DEB')
+const update = yaml.load(readFileSync(join(output, 'app-update.yml'), 'utf8'))
+const expected = `https://github.com/${process.env.DSH_LINUX_OTA_REPOSITORY}/releases/latest/download/`
+if (update.provider !== 'generic' || update.channel !== 'latest' || update.url !== expected) throw new Error('Packaged OTA feed is incorrect')
+console.log(`Verified ${file}, latest-linux.yml, and packaged app-update.yml in ${output}`)
+JS
+echo 'Linux build finished. Upload the DEB and latest-linux.yml together to a public, non-prerelease distribution GitHub Release.'
