@@ -0,0 +1,97 @@
+/** Linux-only package configuration; macOS and Windows retain their upstream release path. */
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { join, relative, resolve, sep } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { desktopTargetBuildPaths } from './desktop-build-paths.mjs'
+
+const APP_ROOT = fileURLToPath(new URL('..', import.meta.url))
+
+/**
+ * Resolve the public repository that serves anonymous Linux updates.
+ * @param {NodeJS.ProcessEnv} env - Build environment containing the distribution repository.
+ * @returns {string} Public GitHub owner/repository identifier.
+ */
+export function linuxOtaRepository(env = process.env) {
+  const repository = env.DSH_LINUX_OTA_REPOSITORY?.trim() ?? ''
+  if (!/^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\/[A-Za-z0-9_.-]+$/u.test(repository)
+    || repository.split('/')[1] === '.' || repository.split('/')[1] === '..') {
+    throw new Error('Linux package: DSH_LINUX_OTA_REPOSITORY must be a public GitHub owner/repository')
+  }
+  return repository
+}
+
+/**
+ * Create a DEB package with a generic electron-updater feed hosted by GitHub Releases.
+ * @param {NodeJS.ProcessEnv} env - Build environment; no credentials are embedded in artifacts.
+ * @returns {object} electron-builder configuration for Ubuntu 24.04 amd64.
+ */
+export function createLinuxElectronBuilderConfig(env = process.env) {
+  const repository = linuxOtaRepository(env)
+  const appId = env.DSH_DESKTOP_APP_ID?.trim() || 'com.deepseek.harness'
+  if (!/^[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+$/u.test(appId)) throw new Error('Linux package: DSH_DESKTOP_APP_ID must be a reverse-DNS identifier')
+  const paths = desktopTargetBuildPaths('linux-x64')
+  const product = JSON.parse(readFileSync(join(APP_ROOT, 'package.json'), 'utf8'))
+  const feed = { provider: 'generic', url: `https://github.com/${repository}/releases/latest/download/`, channel: 'latest' }
+  return {
+    appId,
+    productName: 'DeepSeek Harness',
+    protocols: [{ name: 'DeepSeek Harness', schemes: ['dsh'] }],
+    artifactName: 'deepseek-harness-${version}-linux-amd64.${ext}',
+    extraMetadata: {
+      name: 'deepseek-harness',
+      desktopName: 'deepseek-harness.desktop',
+      author: { name: 'DeepSeek Harness Linux distribution', email: 'noreply@github.com' },
+      homepage: `https://github.com/${repository}`,
+      dshDesktopAppId: appId,
+      dshLinuxOtaRepository: repository,
+    },
+    directories: { app: APP_ROOT, output: resolve(APP_ROOT, '../../dist/linux-ota') },
+    electronDist: paths.electron,
+    electronFuses: { runAsNode: true },
+    asar: true,
+    asarUnpack: ['**/*.{node,dylib,dll,so,exe}', '**/*.so.*', '**/spawn-helper', '**/@vscode/ripgrep-*/bin/rg'],
+    files: [
+      'lib/main.js', 'lib/welcome/**/*', 'lib/preload-*.cjs', 'renderer/**/*', 'package.json',
+      { from: paths.dsh, to: 'dsh', filter: ['**/*'] },
+      { from: join(paths.dsh, 'node_modules'), to: 'dsh/node_modules', filter: ['**/*'] },
+    ],
+    extraResources: [
+      { from: paths.runtime, to: 'runtime' },
+      { from: join(APP_ROOT, 'resources/icon.png'), to: 'icon.png' },
+    ],
+    linux: {
+      executableName: 'deepseek-harness',
+      syncDesktopName: true,
+      icon: join(APP_ROOT, 'resources/icon.png'),
+      category: 'Development',
+      target: [{ target: 'deb', arch: ['x64'] }],
+      desktop: { entry: { StartupWMClass: 'deepseek-harness', Name: 'DeepSeek Harness', Comment: 'DeepSeek Harness Linux desktop' } },
+    },
+    deb: {
+      maintainer: `DeepSeek Harness Linux distribution <noreply@github.com>`,
+      depends: ['libgtk-3-0t64', 'libnotify4', 'libnss3', 'libxss1', 'libxtst6', 'xdg-utils',
+        'libatspi2.0-0t64', 'libuuid1', 'libsecret-1-0', 'libasound2t64', 'libgbm1', 'ca-certificates', 'polkitd', 'pkexec'],
+    },
+    beforePack: async context => {
+      const { officePackageDirectories } = await import('../../../scripts/libreoffice-packages.mjs')
+      const office = await officePackageDirectories(paths.dsh, { platform: 'linux', arch: 'x64' })
+      context.packager.config.asarUnpack = [...context.packager.config.asarUnpack,
+        ...office.map(directory => `**/${relative(paths.dsh, directory).split(sep).join('/')}/**/*`)]
+    },
+    afterPack: async context => {
+      const { verifyDesktopRuntime } = await import('../lib/types/runtime-tree.js')
+      await verifyDesktopRuntime(paths.dsh, product.version, { platform: 'linux', arch: 'x64' })
+      const resources = context.packager.getResourcesDir(context.appOutDir)
+      mkdirSync(resources, { recursive: true })
+      // Explicitly emit this even when electron-builder runs with --publish never.
+      writeFileSync(join(resources, 'app-update.yml'),
+        `provider: generic\nurl: ${feed.url}\nchannel: latest\nupdaterCacheDirName: deepseek-harness-updater\n`)
+    },
+    detectUpdateChannel: false,
+    generateUpdatesFilesForAllChannels: true,
+    publish: [feed],
+  }
+}
+
+// electron-builder loads this module once; avoid requiring configuration during imports by tests.
+export default async function configuration() { return createLinuxElectronBuilderConfig() }
