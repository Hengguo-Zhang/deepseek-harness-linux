diff --git a/apps/desktop/scripts/linux-build-source.mjs b/apps/desktop/scripts/linux-build-source.mjs
new file mode 100644
index 0000000..5fdbd1a
--- /dev/null
+++ b/apps/desktop/scripts/linux-build-source.mjs
@@ -0,0 +1,20 @@
+/** Read the official commit recorded in a source archive that has no Git metadata. */
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+/**
+ * Validate an archive's source identity before supplying its client build commit.
+ * @param {string} root - Source repository root containing package.json and LINUX-SOURCE.json.
+ * @returns {string} Forty-character official source commit recorded by the archive producer.
+ */
+export function linuxArchiveCommit(root) {
+  let record
+  try { record = JSON.parse(readFileSync(join(root, 'LINUX-SOURCE.json'), 'utf8')) }
+  catch { throw new Error('Linux source archive has no readable LINUX-SOURCE.json. Use a Git checkout or set DSH_CLIENT_COMMIT_HASH explicitly.') }
+  const product = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'))
+  if (record === null || typeof record !== 'object' || record.version !== product.version
+    || typeof record.sha !== 'string' || !/^[0-9a-f]{40}$/u.test(record.sha)) {
+    throw new Error('LINUX-SOURCE.json must contain the matching package version and a 40-character official source sha')
+  }
+  return record.sha
+}
